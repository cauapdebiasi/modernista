{
  "name": "modernista",
  "version": "0.1.0",
  "private": true,
  "description": "Design system Modernista — meados do século: blocos de cor chapada, contorno de tinta, sombra dura, três paletas, animações e sons.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css/*": "./css/*",
    "./tokens.json": "./tokens/tokens.json",
    "./assets/*": "./assets/*"
  },
  "files": [
    "src",
    "css",
    "tokens",
    "assets"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "lucide-react": ">=1.0.0",
    "react": ">=19",
    "sonner": ">=2"
  },
  "devDependencies": {
    "@types/react": "^19",
    "lucide-react": "^1.40.0",
    "react": "19.2.8",
    "sonner": "^2.0.8",
    "typescript": "^5"
  }
}
